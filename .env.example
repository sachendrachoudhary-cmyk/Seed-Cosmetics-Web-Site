# ==========================================
# Seed Cosmetics - Environment Configuration
# ==========================================

# Server Settings
PORT=5000
NODE_ENV=development
API_BASE_URL=http://localhost:5000
CLIENT_URL=http://localhost:3000

# Database
# Provide a MongoDB Atlas or local MongoDB URI.
# If omitted or unavailable in development, an embedded in-memory MongoDB engine starts automatically.
MONGODB_URI=mongodb://localhost:27017/seedcosmetics

# JWT & Authentication
JWT_SECRET=seed_cosmetics_jwt_super_secret_key_change_in_production
JWT_EXPIRES_IN=7d

# Razorpay Configuration (INR currency)
# Set your Razorpay Test/Live keys. If dummy keys are kept in development, mock checkout simulation is available.
RAZORPAY_KEY_ID=rzp_test_SeedCosmeticsKey123
RAZORPAY_KEY_SECRET=SeedCosmeticsRazorpaySecret456
RAZORPAY_WEBHOOK_SECRET=SeedCosmeticsWebhookSecret789

# Brand & SEO
SITE_URL=https://www.seedcosmetics.in
BRAND_NAME="Seed Cosmetics"
CONTACT_EMAIL=care@seedcosmetics.in
